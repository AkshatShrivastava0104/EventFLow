APP_NAME=EventFlow
APP_ENV=development
PORT=8080

VITE_API_BASE_URL=http://localhost:8080/api/v1
CORS_ALLOWED_ORIGINS=https://eventflowak.vercel.app

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eventflow

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a random secret of at least 32 bytes (for example: openssl rand -base64 48).
JWT_SECRET=<your-jwt-secret>

METRICS_ADDR=0.0.0.0:9091

# Comma-separated proxy IPs/CIDRs allowed to provide X-Forwarded-For.
# For Nginx on the Docker host, configure its specific bridge gateway address.
TRUSTED_PROXIES=127.0.0.1,::1

CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
CLOUDINARY_UPLOAD_FOLDER=upload/events

GRAFANA_ADMIN_PASSWORD=<your-grafana-admin-password>